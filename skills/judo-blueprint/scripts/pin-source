#!/usr/bin/env python3
"""Add (or update) the JUDO catalog as a pinned kb git source in a consuming project.

Usage: pin-source <tag-or-sha> [--project DIR] [--url URL] [--dry-run] [--json]

Writes into <project>/.pi/dashboard/knowledge_base.json:
  {"kind": "git", "ref": <url>, "pin": <tag-or-sha>, "subdir": "catalog", "priority": 10}
Only the `catalog/` folder is indexed (agent-docs, best-practices, model-blueprints).
Existing sources are kept; an earlier judo-blueprint git source is replaced, not duplicated.
This only edits a local file. It never pushes or changes any remote.
Exit codes: 0 written (or unchanged), 2 usage error.
"""
import argparse
import json
import pathlib
import sys

DEFAULT_URL = "git@github.com:BlackBeltTechnology/judo-blueprint.git"


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("pin", help="release tag (e.g. v1.0.0) or commit SHA")
    ap.add_argument("--project", default=".", help="consuming project root (default: cwd)")
    ap.add_argument("--url", default=DEFAULT_URL)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.pin in ("develop", "master", "main", "HEAD"):
        print("pin must be a tag or SHA, not a moving branch", file=sys.stderr)
        return 2
    cfg_path = pathlib.Path(a.project).resolve() / ".pi" / "dashboard" / "knowledge_base.json"
    cfg = json.loads(cfg_path.read_text()) if cfg_path.exists() else {}
    sources = cfg.get("sources") or [{"kind": "filesystem", "ref": ".", "priority": 0}]
    mine = {"kind": "git", "ref": a.url, "pin": a.pin, "subdir": "catalog", "priority": 10}
    kept = [s for s in sources if not (s.get("kind") == "git" and "judo-blueprint" in str(s.get("ref", "")))]
    new = dict(cfg, sources=kept + [mine])
    changed = new != cfg
    if not a.dry_run and changed:
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        cfg_path.write_text(json.dumps(new, indent=2) + "\n")
    if a.json:
        print(json.dumps({"path": str(cfg_path), "changed": changed, "dryRun": a.dry_run, "source": mine}))
    else:
        verb = "would write" if a.dry_run else ("wrote" if changed else "unchanged")
        print(f"{verb} {cfg_path}: judo-blueprint@{a.pin} (subdir catalog)")
        if changed and not a.dry_run:
            print("next: reload the kb (/reload in pi) so the catalog is cloned and indexed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
