#!/usr/bin/env python3
"""Print the Mermaid diagram of a scope of a real JUDO model (read-only, stdout).

Usage:
  render --model <path> --scope <fqn> [--depth N] [--kinds k,..] [--members m] [--json]

The model is never changed. Paste the output into a catalog entry as a plain
```mermaid block and generalise the names (no project or client terms).
The catalog stores only the Mermaid text, never a model file.
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[2] / "_lib"))
from judo_common import run_cli, die  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    ap.add_argument("--model", required=True)
    ap.add_argument("--scope", required=True)
    ap.add_argument("--depth")
    ap.add_argument("--kinds")
    ap.add_argument("--members")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    m = pathlib.Path(a.model).resolve()
    if not m.exists():
        die(f"model not found: {m}")
    args = ["mermaid", "model", "--scope", a.scope]
    for opt, val in (("--depth", a.depth), ("--kinds", a.kinds), ("--members", a.members)):
        if val:
            args += [opt, val]
    r = run_cli(args, cwd=str(m.parent), model=str(m))
    print(json.dumps({"scope": a.scope, "mermaid": r.stdout}) if a.json else r.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
