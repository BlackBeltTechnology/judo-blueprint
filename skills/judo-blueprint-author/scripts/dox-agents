#!/usr/bin/env python3
"""Generate the DOX AGENTS.md per catalog directory (spec catalog-kb-indexing: DOX AGENTS.md per catalog directory).

Usage: dox-agents [--check]

Each catalog directory gets AGENTS.md with a `| File | Purpose |` table: one row per markdown file
(or per entry directory for model-blueprints), Purpose = the entry's frontmatter description
(first sentence, one line). --check exits 1 when any AGENTS.md is missing or out of date.
"""
import argparse
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[3]
CAT = ROOT / "catalog"
HEAD = "<!-- generated by skills/judo-blueprint-author/scripts/dox-agents; do not edit -->"


def desc(p):
    t = p.read_text()
    m = re.match(r"^---\n(.*?)\n---\n", t, re.S)
    d = ""
    if m:
        mm = re.search(r"^description:\s*(.+)$", m.group(1), re.M)
        if mm:
            d = mm.group(1).strip().strip('"').replace('\\"', '"')
    if not d:
        h = re.search(r"^# (.+)$", t, re.M)
        d = h.group(1) if h else p.stem
    d = re.split(r"(?<=[.!?])\s", d)[0]
    return d.replace("|", "\\|")[:200]


SUBDIR_PURPOSE = {
    "agent-docs": "Platform behaviour and rules; source of truth for platform facts",
    "best-practices": "Practices by domain: model, backend, frontend, project",
    "model-blueprints": "Reusable model shapes with generated diagram and layer guidance",
    "model": "Modelling practices",
    "backend": "Backend practices",
    "frontend": "Frontend practices",
    "project": "Repository-level layout practices",
}


def rows_for(d):
    rows = []
    for c in sorted(d.iterdir()):
        if c.name.startswith(".") or c.name == "AGENTS.md":
            continue
        if c.is_dir():
            bp = c / "BLUEPRINT.md"
            readme = c / "README.md"
            target = bp if bp.exists() else readme if readme.exists() else None
            bp = c / "BLUEPRINT.md"
            if bp.exists():  # one row per blueprint file: BLUEPRINT.md carries the description, layers say what they hold
                rows.append((f"{c.name}/BLUEPRINT.md", desc(bp)))
                for layer, what in (("model.md", "model shape and generated structure diagram"),
                                    ("backend.md", "backend guidance"), ("frontend.md", "frontend guidance")):
                    if (c / layer).exists():
                        rows.append((f"{c.name}/{layer}", f"{c.name}: {what}"))
                for comp in sorted(c.glob("*.agent.md")):
                    src = comp.name[: -len(".agent.md")] + ".md"
                    rows.append((f"{c.name}/{comp.name}", f"{c.name}: condensed map of `{src}`"))
            # other subdirectories carry their own AGENTS.md; list them so parent indexes are navigable
            n = sum(1 for _ in c.rglob("BLUEPRINT.md")) or sum(
                1 for p in c.rglob("*.md") if p.name != "AGENTS.md")
            purpose = desc(readme) if readme.exists() else SUBDIR_PURPOSE.get(c.name, c.name)
            rows.append((f"{c.name}/", f"{purpose} ({n} files; index in `{c.name}/AGENTS.md`)"))
            continue
        elif c.name.endswith(".agent.md"):
            src = c.name[: -len(".agent.md")] + ".md"
            rows.append((c.name, f"Condensed map of `{src}`: read first, then `kb_get` one section"))
        elif c.suffix == ".md":
            rows.append((c.name, desc(c)))
    return rows


def render(d):
    title = "catalog" if d == CAT else str(d.relative_to(CAT))
    out = [f"# {title}", "", HEAD, "", f"## DOX — {title}", "", "| File | Purpose |", "|---|---|"]
    out += [f"| `{f}` | {p} |" for f, p in rows_for(d)]
    return "\n".join(out) + "\n"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    stale = []
    # Blueprint entry directories are listed in model-blueprints/AGENTS.md (row -> BLUEPRINT.md);
    # a per-entry AGENTS.md would duplicate the entry description and outrank the entry in kb_search.
    dirs = [CAT] + sorted(p for p in CAT.rglob("*") if p.is_dir() and not p.name.startswith(".")
                          and not (p / "BLUEPRINT.md").exists())
    for d in CAT.glob("model-blueprints/*/AGENTS.md"):
        if not a.check:
            d.unlink()
        else:
            stale.append(str(d.relative_to(ROOT)))
    for d in dirs:
        want = render(d)
        f = d / "AGENTS.md"
        have = f.read_text() if f.exists() else None
        if have != want:
            stale.append(str(f.relative_to(ROOT)))
            if not a.check:
                f.write_text(want)
    print(f"{len(dirs)} directories, {len(stale)} {'stale' if a.check else 'written'}")
    return 1 if (a.check and stale) else 0


if __name__ == "__main__":
    sys.exit(main())
