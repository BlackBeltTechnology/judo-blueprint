#!/usr/bin/env python3
"""List catalog entries that two or more swept projects both map candidates to (design D10b, task 7.1b).

Usage: sweep-overlap [project ...] [--json]

Reads the newest W/decisions.json (or W/candidates.json when no decisions yet) of each project under
target/sweep/. An overlap is an entry id that several projects add evidence to; these are the entries whose
`projects:` list and status (single-project -> emerging -> established) change after the sweeps.
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from _sweep import SWEEP  # noqa: E402


def norm(e):
    return e.rstrip("/").rsplit("/", 1)[-1].removesuffix(".md").removesuffix("/BLUEPRINT")


def entries_of(w):
    for name in ("decisions.json", "candidates.json"):
        p = w / name
        if p.exists():
            d = json.loads(p.read_text())
            items = d.get("decisions") or d.get("candidates") or []
            # ids come as "x", "model-blueprints/x" or "best-practices/<d>/x.md": compare the bare id
            return {norm(i.get("entry") or i.get("match")) for i in items
                    if (i.get("entry") or i.get("match")) and i.get("decision", "add-evidence") != "reject"}, name
    return set(), None


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("projects", nargs="*")
    ap.add_argument("--root", default=str(SWEEP), help=argparse.SUPPRESS)
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    root = pathlib.Path(a.root)
    projects = a.projects or sorted(p.name for p in root.iterdir() if p.is_dir()) if root.exists() else []
    seen = {}
    for proj in projects:
        ws = sorted((p for p in (root / proj).glob("*") if p.is_dir()), key=lambda p: p.stat().st_mtime)
        if not ws:
            continue
        ids, src = entries_of(ws[-1])
        for i in ids:
            seen.setdefault(i, []).append(proj)
    overlap = {k: v for k, v in sorted(seen.items()) if len(v) > 1}
    if a.json:
        print(json.dumps(overlap))
    else:
        print("\n".join(f"{k}: {', '.join(v)}" for k, v in overlap.items()) or "no overlapping entries")
    return 0


if __name__ == "__main__":
    sys.exit(main())
