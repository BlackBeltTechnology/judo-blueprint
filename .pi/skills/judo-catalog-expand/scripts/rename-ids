#!/usr/bin/env python3
"""rename-ids: after entries were renamed, rewrite every reference to the old ids.

Usage: rename-ids <log.jsonl> [<log.jsonl> ...] [--dry-run]

Reads {"type":"id","old","new"} lines, or "renames" lists inside catalog-pass log lines.
Rewrites in catalog/**/*.md: [[old]] wikilinks, `related:` / `alternatives:` frontmatter lists,
and relative markdown links to the old file or folder. `aliases:` lines are left alone
(the old id stays there on purpose). Prints changed files and any remaining old-id mention.
Run dox-agents and check-all afterwards.
"""
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[4]


def main(a):
    dry = "--dry-run" in a
    logs = [x for x in a if x != "--dry-run"]
    if not logs:
        print(__doc__)
        return 2
    ids = {}
    for f in logs:
        for line in open(f):
            if line.strip():
                o = json.loads(line)
                for r in [o] + (o.get("renames") or []):
                    if r.get("type") == "id":
                        ids[r["old"]] = r["new"]
    changed = 0
    for f in (ROOT / "catalog").rglob("*.md"):
        t = f.read_text()
        n = t
        for old, new in ids.items():
            n = n.replace(f"[[{old}]]", f"[[{new}]]")
            n = re.sub(rf"(^(?:related|alternatives):.*?)\b{re.escape(old)}\b",
                       lambda m: m.group(1) + new, n, flags=re.M)
            n = re.sub(rf"(\]\([./]*(?:model-blueprints/|best-practices/[a-z]+/)?){re.escape(old)}(/BLUEPRINT\.md|\.md)",
                       lambda m: m.group(1) + new + m.group(2), n)
        if n != t:
            changed += 1
            print(("would change " if dry else "changed ") + str(f.relative_to(ROOT)))
            if not dry:
                f.write_text(n)
    pat = "\\|".join(ids)
    left = subprocess.run(f"grep -rn '{pat}' catalog | grep -v 'aliases:' | grep -v AGENTS.md",
                          shell=True, cwd=ROOT, capture_output=True, text=True).stdout
    print(f"{changed} files; remaining old-id mentions:", "none" if not left else "\n" + left)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
