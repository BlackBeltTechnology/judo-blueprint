#!/usr/bin/env python3
"""vocab-scan: find project names and client-domain words left in catalog entry bodies.

Usage: vocab-scan [--terms "campaign,contest,player,..."]

Body = text after the frontmatter, with generated Mermaid blocks removed (frontmatter
projects/evidence/tags and aliases may name projects and old domain words on purpose).
Project names come from PROJECTS.md; extra --terms are client-domain words to hunt.
"""
import collections
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[4]
PROJECTS = ROOT / ".pi/skills/judo-catalog-maintain/references/PROJECTS.md"
DEFAULT_TERMS = ("campaign,contest,player,quiz,trivia,job ?sheet,freight,garage,planet,rack,"
                 "advertiser,parking,scoreboard,forecast")


def main(a):
    terms = DEFAULT_TERMS
    if "--terms" in a:
        terms = a[a.index("--terms") + 1]
    names = re.findall(r"^\| \d+ \| \*\*([^*]+)\*\*", PROJECTS.read_text(), re.M)
    names = [n for n in names if n.lower() not in {"alba", "trivia"}]
    rx = re.compile(r"(?i)\b(" + "|".join([re.escape(n) for n in names] + terms.split(",")) + r")(?:s|es)?\b")
    hits = collections.Counter()
    per_file = collections.Counter()
    for f in (ROOT / "catalog").rglob("*.md"):
        if f.name == "AGENTS.md":
            continue
        t = f.read_text()
        m = re.match(r"---\n.*?\n---\n", t, re.S)
        body = t[m.end():] if m else t
        for mm in rx.finditer(body):
            hits[mm.group(1).lower()] += 1
            per_file[str(f.relative_to(ROOT))] += 1
    print("terms:", dict(hits.most_common()))
    for f, n in per_file.most_common(30):
        print(f"{n:4d} {f}")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
