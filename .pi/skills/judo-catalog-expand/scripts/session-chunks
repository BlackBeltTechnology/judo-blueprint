#!/usr/bin/env python3
"""session-chunks: split a pi session JSONL into compact text chunks for parallel miners.

Usage:
  session-chunks <session.jsonl> <work-dir> [--max-bytes 450000]
  session-chunks <session.jsonl> --dump START END          (print lines START..END)
  session-chunks <session.jsonl> --prompts                 (list user prompts with line numbers)

Chunks break at user prompts (round boundaries) and stay under --max-bytes.
Each chunk is <work-dir>/chunks/cNN_L<start>-<end>.txt with lines
`[N] USER|ASSISTANT|TOOLRESULT: text` and `[N] CALL name: args`, N = JSONL line.
"""
import json
import pathlib
import sys


def render(path, start=0, end=None):
    out = []
    for i, line in enumerate(open(path)):
        if i < start:
            continue
        if end is not None and i > end:
            break
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if d.get("type") != "message":
            continue
        m = d["message"]
        role = m.get("role", "")
        content = m.get("content")
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        for b in content or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b["text"].strip():
                limit = 1500 if role == "toolResult" else 4000
                out.append((i, f"[{i}] {role.upper()}: {b['text'][:limit]}"))
            elif b.get("type") == "toolCall":
                out.append((i, f"[{i}] CALL {b.get('name')}: {json.dumps(b.get('arguments'))[:1200]}"))
    return out


def prompts(path):
    for i, line in enumerate(open(path)):
        d = json.loads(line)
        if d.get("type") == "message" and d["message"].get("role") == "user":
            c = d["message"]["content"]
            t = c if isinstance(c, str) else " ".join(b.get("text", "") for b in c if isinstance(b, dict))
            print(i, d.get("timestamp", "")[:16], t[:90].replace("\n", " "))


def main(a):
    if len(a) < 2:
        print(__doc__)
        return 2
    src = a[0]
    if a[1] == "--prompts":
        prompts(src)
        return 0
    if a[1] == "--dump":
        for _, t in render(src, int(a[2]), int(a[3])):
            print(t)
        return 0
    work = pathlib.Path(a[1])
    cap = int(a[a.index("--max-bytes") + 1]) if "--max-bytes" in a else 450000
    rows = render(src)
    user_lines = {i for i, t in rows if t.startswith(f"[{i}] USER")}
    (work / "chunks").mkdir(parents=True, exist_ok=True)
    chunks, cur, size = [], [], 0
    for i, t in rows:
        if cur and (size + len(t) > cap or (i in user_lines and size > cap // 2)):
            chunks.append(cur)
            cur, size = [], 0
        cur.append((i, t))
        size += len(t) + 1
    if cur:
        chunks.append(cur)
    for n, c in enumerate(chunks, 1):
        f = work / "chunks" / f"c{n:02d}_L{c[0][0]}-{c[-1][0]}.txt"
        f.write_text("\n".join(t for _, t in c) + "\n")
        print(f.name, f.stat().st_size)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
