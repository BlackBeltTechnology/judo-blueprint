[
 {
  "id": "R1458",
  "kind": "triage",
  "file": "catalog/agent-docs/deployment/schema-evolution.md",
  "text": "Incremental Liquibase diffs add a TableExists precondition to every table, because the previous-model check always returns true.",
  "evidence": "runtime/judo-tatami-base:judo-tatami-base:judo-tatami-rdbms2liquibase/src/main/java/hu/blackbelt/judo/tatami/rdbms2liquibase/zeta/Rdbms2LiquibaseIncrementalZetaTransformation.java:1022"
 },
 {
  "id": "R1459",
  "kind": "triage",
  "file": "catalog/agent-docs/deployment/schema-evolution.md",
  "text": "The pre-check backup table name is the backup prefix, an underscore and the table SQL name, with no truncation or uppercasing.",
  "evidence": "runtime/judo-tatami-base:judo-tatami-base:judo-tatami-rdbms2liquibase/src/main/java/hu/blackbelt/judo/tatami/rdbms2liquibase/zeta/Rdbms2LiquibaseIncrementalZetaTransformation.java:1071"
 },
 {
